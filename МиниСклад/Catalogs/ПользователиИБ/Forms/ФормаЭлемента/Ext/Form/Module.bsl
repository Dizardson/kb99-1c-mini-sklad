#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура УстановитьСписокРазрешенныхСкладов(Команда)
	ОткрытьФорму("Справочник.Склады.ФормаВыбора", , ЭтаФорма);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбработкаВыбораНаСервере(ВыбранноеЗначение)
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ВызватьИсключение "Сначала запишите пользователя";
	КонецЕсли;

	Запись = РегистрыСведений.РегистрНазначенийСкладов.СоздатьМенеджерЗаписи();
	Запись.Склад = ВыбранноеЗначение;
	Запись.Сотрудник = Объект.Ссылка;
	Запись.Записать();
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	ОбработкаВыбораНаСервере(ВыбранноеЗначение);
КонецПроцедуры

#КонецОбласти