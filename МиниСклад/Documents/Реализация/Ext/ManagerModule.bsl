#Область Печать

//Формирует печатную форму документа "Реализация"
Процедура Печать(ТабличныйДокумент, СсылкаНаДокумент) Экспорт
	МакетПечати = Документы.Реализация.ПолучитьМакет("Печать");
	ЗапросДанных = Новый Запрос;
	ЗапросДанных.Текст =
	"ВЫБРАТЬ
	|	Реализация.Дата,
	|	Реализация.Номер,
	|	Реализация.Покупатель,
	|	Реализация.Товары.(
	|		НомерСтроки,
	|		Товар,
	|		Количество,
	|		Цена,
	|		Сумма
	|	)
	|ИЗ
	|	Документ.Реализация КАК Реализация
	|ГДЕ
	|	Реализация.Ссылка В (&Ссылка)";
	ЗапросДанных.Параметры.Вставить("Ссылка", СсылкаНаДокумент);
	ВыборкаДокументов = ЗапросДанных.Выполнить().Выбрать();
	
	ТабличныйДокумент.Очистить();
	
	ВставлятьРазделительСтраниц = Ложь;
	Пока ВыборкаДокументов.Следующий() Цикл
		Если ВставлятьРазделительСтраниц Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;	
		ВывестиШапку(ТабличныйДокумент, МакетПечати, ВыборкаДокументов);
		ВывестиТабличнуюЧасть(ТабличныйДокумент, МакетПечати, ВыборкаДокументов);	
		ВставлятьРазделительСтраниц = Истина;
	КонецЦикла;
КонецПроцедуры

Процедура ВывестиШапку(ТабличныйДокумент, МакетПечати, ВыборкаДокументов)
	ОбластьЗаголовка = МакетПечати.ПолучитьОбласть("Заголовок");
	ОбластьШапка = МакетПечати.ПолучитьОбласть("Шапка");
	ТабличныйДокумент.Вывести(ОбластьЗаголовка);
	ОбластьШапка.Параметры.Заполнить(ВыборкаДокументов);
	ТабличныйДокумент.Вывести(ОбластьШапка, ВыборкаДокументов.Уровень());
	
КонецПроцедуры

Процедура ВывестиТабличнуюЧасть(ТабличныйДокумент, МакетПечати, ВыборкаДокументов)
	ОбластьШапкиТоваров = МакетПечати.ПолучитьОбласть("ТоварыШапка");
	ОбластьСтрокиТовара = МакетПечати.ПолучитьОбласть("Товары");
	ОбластьИтогов = МакетПечати.ПолучитьОбласть("Всего");
	ТабличныйДокумент.Вывести(ОбластьШапкиТоваров);
	ВыборкаСтрокТоваров = ВыборкаДокументов.Товары.Выбрать();
	ИтоговаяСумма = 0;
	Пока ВыборкаСтрокТоваров.Следующий() Цикл
		ОбластьСтрокиТовара.Параметры.Заполнить(ВыборкаСтрокТоваров);
		ТабличныйДокумент.Вывести(ОбластьСтрокиТовара, ВыборкаСтрокТоваров.Уровень());
		ИтоговаяСумма = ИтоговаяСумма + ВыборкаСтрокТоваров.Сумма;
	КонецЦикла;
	
	ОбластьИтогов.Параметры.ВсегоПоДокументу = ИтоговаяСумма;
	ТабличныйДокумент.Вывести(ОбластьИтогов);
КонецПроцедуры

#КонецОбласти
