#Область ОписаниеПеременных

Перем ДатаНачалаПересчета;
Перем ВнутреннийПересчетFIFO;
Перем ТоварыДляПересчета;

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если РежимЗаписи <> РежимЗаписиДокумента.Проведение
		И РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения
		ИЛИ ВнутреннийПересчетFIFO = Истина Тогда
		//Ранний возврат обусловлен тем, что дальнейший код должен выполняться
		//при проведении или при отмене проведения документа реализация,
		//который был проведен неоперативно
		Возврат;
	КонецЕсли;
	ДатаНачалаПересчета = Дата;
	ТоварыДляПересчета = Новый Массив;
	Для Каждого СтрокаТовара ИЗ Товары Цикл
		Если ТоварыДляПересчета.Найти(СтрокаТовара.Товар) = Неопределено Тогда
			ТоварыДляПересчета.Добавить(СтрокаТовара.Товар);
		КонецЕсли;
	КонецЦикла;
	Если НЕ ЭтоНовый() Тогда
		ЗапросПрежнихДанныхРеализации = Новый Запрос;
		ЗапросПрежнихДанныхРеализации.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Реализация.Дата КАК Дата,
		|	РеализацияТовары.Товар КАК Товар
		|ИЗ
		|	Документ.Реализация КАК Реализация
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Реализация.Товары КАК РеализацияТовары
		|		ПО Реализация.Ссылка = РеализацияТовары.Ссылка
		|ГДЕ
		|	Реализация.Проведен = ИСТИНА
		|	И Реализация.Ссылка = &СсылкаТекущейРеализации";
		ЗапросПрежнихДанныхРеализации.УстановитьПараметр("СсылкаТекущейРеализации",
			Ссылка);
		ВыборкаПрежнихДанныхРеализации = 
			ЗапросПрежнихДанныхРеализации.Выполнить().Выбрать();
		Пока ВыборкаПрежнихДанныхРеализации.Следующий() Цикл
			Если ВыборкаПрежнихДанныхРеализации.Дата < ДатаНачалаПересчета Тогда
				ДатаНачалаПересчета = ВыборкаПрежнихДанныхРеализации.Дата;
			КонецЕсли;
			Если ЗначениеЗаполнено(ВыборкаПрежнихДанныхРеализации.Товар)
				И ТоварыДляПересчета.Найти(ВыборкаПрежнихДанныхРеализации.Товар)
				= Неопределено Тогда
				ТоварыДляПересчета.Добавить(ВыборкаПрежнихДанныхРеализации.Товар);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	Если ВнутреннийПересчетFIFO = Истина Тогда
		СформироватьДвижениеFIFO(Отказ);
		//Данный преждевременный выход из процедуры обусловлен тем, что
		//Если обработка проведения вызвана при пересчитывании последующих
		//по хронологии документов Реализация, то они не должны выполнять дальнейший
		//код, который будет запускать пересчет последующей цепочки
		Возврат;
	КонецЕсли;
	FIFOПересчетСервер.ПересчитатьРеализацииFIFO(ДатаНачалапересчета, 
		ТоварыДляПересчета, ЭтотОбъект, Документы.Реализация.ПустаяСсылка(), Отказ);
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	FIFOПересчетСервер.ОчиститьДвиженияДокумента(Ссылка);
	FIFOПересчетСервер.ПересчитатьРеализацииFIFO(ДатаНачалаПересчета, ТоварыДляПересчета,
		Неопределено, Ссылка, Отказ);
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

Процедура УстановитьВнутреннийПересчетFIFO() Экспорт
	ВнутреннийПересчетFIFO = Истина;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедуры

Процедура СообщитьОНедостаткеТовара(Товар, НедостающееКоличество, Отказ)
	Сообщение = Новый СообщениеПользователю();
	Сообщение.Текст = "Реализация " + Строка(Ссылка) + Символы.ПС
		+ "Не хватает " + Строка(НедостающееКоличество) + " единиц товара "
		+ Строка(Товар);
	Сообщение.Сообщить();
	Отказ = Истина;
КонецПроцедуры

#КонецОбласти

#Область ФормированиеДвиженийFIFO

Процедура СформироватьДвижениеFIFO(Отказ) Экспорт
	
	#Область СозданиеВременнойТаблицыТоваров
	
	ЗапросСозданияВременнойТаблицы = Новый Запрос;
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ЗапросСозданияВременнойТаблицы.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	ЗапросСозданияВременнойТаблицы.Текст = 
	"ВЫБРАТЬ
	|	РеализацияТовары.Товар КАК Товар,
	|	СУММА(РеализацияТовары.Количество) КАК Количество,
	|	СУММА(РеализацияТовары.Сумма) КАК Сумма
	|ПОМЕСТИТЬ ТоварыДокумента
	|ИЗ
	|	Документ.Реализация.Товары КАК РеализацияТовары
	|ГДЕ
	|	РеализацияТовары.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	РеализацияТовары.Товар";	
	ЗапросСозданияВременнойТаблицы.УстановитьПараметр("Ссылка", Ссылка);	
	РезультатЗапроса = ЗапросСозданияВременнойТаблицы.Выполнить();
	
	#КонецОбласти
	
	#Область РасчетСебестоимостиИДвижений
	
	ЗапросОстатковТоваров = Новый Запрос;
	ЗапросОстатковТоваров.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	ЗапросОстатковТоваров.Текст = 
	"ВЫБРАТЬ
	|	ТоварыДокумента.Товар КАК Товар,
	|	ТоварыДокумента.Количество КАК КоличествоВДокументе,
	|	ТоварыДокумента.Сумма КАК СуммаВДокументе,
	|	ЕСТЬNULL(ОстаткиТоваровОстатки.КоличествоОстаток, 0) КАК Количество,
	|	ЕСТЬNULL(ОстаткиТоваровОстатки.СуммаОстаток, 0) КАК Сумма,
	|	ОстаткиТоваровОстатки.Партия КАК Партия
	|ИЗ
	|	ТоварыДокумента КАК ТоварыДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваров.Остатки(
	|				&МоментДокумента,
	|				Товары В
	|					(ВЫБРАТЬ
	|						ТоварыДокумента.Товар
	|					ИЗ
	|						ТоварыДокумента)) КАК ОстаткиТоваровОстатки
	|		ПО (ТоварыДокумента.Товар = ОстаткиТоваровОстатки.Товары
	|				И ОстаткиТоваровОстатки.КоличествоОстаток > 0)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Товар,
	|	ОстаткиТоваровОстатки.Партия.Дата,
	|	Партия";
	ЗапросОстатковТоваров.УстановитьПараметр("МоментДокумента", 
		Новый МоментВремени(Дата,Ссылка));
	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.Обороты.Записывать = Истина;
	Движения.ОстаткиТоваров.БлокироватьДляИзменения = Истина;
	Движения.ОстаткиТоваров.Записать();
	Движения.Обороты.Записать();
	РезультатЗапроса = ЗапросОстатковТоваров.Выполнить();	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	ТекущийТовар = Неопределено;
	ОсталосьСписать = 0;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ТекущийТовар <> ВыборкаДетальныеЗаписи.Товар Тогда
			Если ОсталосьСписать > 0 Тогда
				СообщитьОНедостаткеТовара(ТекущийТовар, ОсталосьСписать, Отказ);
				//Данный ранний выход из процедуры происходит потому, что проводится
				//списание товаров в колличестве большем, чем имеющийся остаток
				Возврат;
			КонецЕсли;
			ТекущийТовар = ВыборкаДетальныеЗаписи.Товар;
			ОсталосьСписать = ВыборкаДетальныеЗаписи.КоличествоВДокументе;
			ДвижениеОбороты = Движения.Обороты.Добавить();
			ДвижениеОбороты.Период = Дата;
			ДвижениеОбороты.Товары = ВыборкаДетальныеЗаписи.Товар;
			ДвижениеОбороты.Количество = ВыборкаДетальныеЗаписи.КоличествоВДокументе;
			ДвижениеОбороты.Сумма = ВыборкаДетальныеЗаписи.СуммаВДокументе;
		КонецЕсли;
		Если ОсталосьСписать <= 0 Или ВыборкаДетальныеЗаписи.Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;
		КоличествоИзПартии = Мин(ОсталосьСписать, ВыборкаДетальныеЗаписи.Количество);
		Если КоличествоИзПартии = ВыборкаДетальныеЗаписи.Количество Тогда
			СуммаСписания = ВыборкаДетальныеЗаписи.Сумма;
		Иначе
			СуммаСписания = ВыборкаДетальныеЗаписи.Сумма * КоличествоИзПартии
				/ ВыборкаДетальныеЗаписи.Количество;
		КонецЕсли;	
		ДвижениеОстаткиТоваров = Движения.ОстаткиТоваров.Добавить();
		ДвижениеОстаткиТоваров.ВидДвижения = ВидДвиженияНакопления.Расход;
		ДвижениеОстаткиТоваров.Период = Дата;
		ДвижениеОстаткиТоваров.Товары = ТекущийТовар;
		ДвижениеОстаткиТоваров.Партия = ВыборкаДетальныеЗаписи.Партия;
		ДвижениеОстаткиТоваров.Количество = КоличествоИзПартии;
		ДвижениеОстаткиТоваров.Сумма = СуммаСписания;	
		ОсталосьСписать = ОсталосьСписать - КоличествоИзПартии;
	КонецЦикла;
	Если ОсталосьСписать > 0 Тогда
		СообщитьОНедостаткеТовара(ТекущийТовар, ОсталосьСписать, Отказ);
		//Данный ранний выход из процедуры происходит потому, что после
		//списания товаров в колличестве большем, чем имеющийся остаток
		Возврат;
	КонецЕсли;
	Движения.Записать();
	
	#КонецОбласти
	
КонецПроцедуры

#КонецОбласти