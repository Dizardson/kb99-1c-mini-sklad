#Область ОбработчикиСобытий

&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	ТабличныйДокумент = Новый ТабличныйДокумент;
	Печать(ТабличныйДокумент, ПараметрКоманды);
	ТабличныйДокумент.ОтображатьСетку = Ложь;
	ТабличныйДокумент.Защита = Ложь;
	ТабличныйДокумент.ТолькоПросмотр = Ложь;
	ТабличныйДокумент.ОтображатьЗаголовки = Ложь;
	ТабличныйДокумент.Показать();
КонецПроцедуры

#КонецОбласти

#Область Печать

&НаСервере
Процедура Печать(ТабличныйДокумент, ПараметрКоманды)
	Документы.Реализация.ВывестиПечатнуюФорму(ТабличныйДокумент, ПараметрКоманды);
КонецПроцедуры

#КонецОбласти