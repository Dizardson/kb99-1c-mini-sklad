#Область ОписаниеПеременных

Перем ДатаНачалаПересчета;
Перем ТоварыДляПересчета;

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если РежимЗаписи <> РежимЗаписиДокумента.Проведение
		И РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения Тогда
		//Ранний возврат обусловлен тем, что дальнейший код должен выполняться
		//только при проведении или отмене проведения документа поступленяе
		Возврат;
	КонецЕсли;
	ДатаНачалаПересчета = Дата;
	ТоварыДляПересчета = Новый Массив;
	Для Каждого СтрокаТовара ИЗ Товары Цикл
		Если ТоварыДляПересчета.Найти(СтрокаТовара.Товар) = Неопределено Тогда
			ТоварыДляПересчета.Добавить(СтрокаТовара.Товар);
		КонецЕсли;
	КонецЦикла;
	Если НЕ ЭтоНовый() Тогда
		ЗапросПрежнихДанныхПоступления = Новый Запрос;
		ЗапросПрежнихДанныхПоступления.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Поступление.Дата КАК Дата,
		|	ПоступлениеТовары.Товар КАК Товар
		|ИЗ
		|	Документ.Поступление КАК Поступление
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Поступление.Товары КАК ПоступлениеТовары
		|		ПО Поступление.Ссылка = ПоступлениеТовары.Ссылка
		|ГДЕ
		|	Поступление.Проведен = ИСТИНА
		|	И Поступление.Ссылка = &СсылкаТекущегоПоступления";
		ЗапросПрежнихДанныхПоступления.УстановитьПараметр("СсылкаТекущегоПоступления",
			Ссылка);
		ВыборкаПрежнихДанныхПоступления = 
			ЗапросПрежнихДанныхПоступления.Выполнить().Выбрать();
		Пока ВыборкаПрежнихДанныхПоступления.Следующий() Цикл
			Если ВыборкаПрежнихДанныхПоступления.Дата < ДатаНачалаПересчета Тогда
				ДатаНачалаПересчета = ВыборкаПрежнихДанныхПоступления.Дата;
			КонецЕсли;
			Если ЗначениеЗаполнено(ВыборкаПрежнихДанныхПоступления.Товар)
				И ТоварыДляПересчета.Найти(ВыборкаПрежнихДанныхПоступления.Товар)
				= Неопределено Тогда
				ТоварыДляПересчета.Добавить(ВыборкаПрежнихДанныхПоступления.Товар);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	СформироватьДвиженияПоступления();
	Движения.ОстаткиТоваров.Записать();
	Движения.Обороты.Записать();
	FIFOПересчетСервер.ПересчитатьРеализацииFIFO(ДатаНачалаПересчета,
		ТоварыДляПересчета, Неопределено, Документы.Реализация.ПустаяСсылка(), Отказ);
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	FIFOПересчетСервер.ОчиститьДвиженияДокумента(Ссылка);
	FIFOПересчетСервер.ПересчитатьРеализацииFIFO(ДатаНачалаПересчета, ТоварыДляПересчета,
		Неопределено, Документы.Реализация.ПустаяСсылка(), Отказ);
КонецПроцедуры

#КонецОбласти

#Область ФормированиеДвижений

Процедура СформироватьДвиженияПоступления()
	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.Обороты.Записывать = Истина;
	Для Каждого ТекущаяСтрокаТоваров Из Товары Цикл
		ДвижениеОстаткиТоваров = Движения.ОстаткиТоваров.Добавить();
		ДвижениеОстаткиТоваров.ВидДвижения = ВидДвиженияНакопления.Приход;
		ДвижениеОстаткиТоваров.Период = Дата;
		ДвижениеОстаткиТоваров.Товары = ТекущаяСтрокаТоваров.Товар;
		ДвижениеОстаткиТоваров.Количество = ТекущаяСтрокаТоваров.Количество;
		ДвижениеОстаткиТоваров.Сумма = ТекущаяСтрокаТоваров.Сумма;
		ДвижениеОстаткиТоваров.Партия = Ссылка;
		
		ДвижениеОбороты = Движения.Обороты.Добавить();
		ДвижениеОбороты.Период = Дата;
		ДвижениеОбороты.Товары = ТекущаяСтрокаТоваров.Товар;
		ДвижениеОбороты.Количество = ТекущаяСтрокаТоваров.Количество;
		ДвижениеОбороты.Сумма = ТекущаяСтрокаТоваров.Сумма;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти