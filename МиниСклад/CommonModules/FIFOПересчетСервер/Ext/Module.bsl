#Область ПрограммныйИнтерфейс

Функция ПолучитьРеализацииДляПересчета(ДатаНачалаПересчета, ТоварыДляПересчета,
		СсылкаТекущейРеализации, ИсключаемаяРеализация) Экспорт
	ЗапросРеализацийДляПересчета = Новый Запрос;
	ЗапросРеализацийДляПересчета.Текст = 
	"ВЫБРАТЬ
	|	Реализация.Ссылка КАК Ссылка,
	|	Реализация.Дата КАК Дата
	|ИЗ
	|	Документ.Реализация КАК Реализация
	|ГДЕ
	|	Реализация.Дата >= &Дата
	|		И (Реализация.Ссылка = &СсылкаТекущейРеализации
	|		ИЛИ (
	|			Реализация.Проведен = ИСТИНА
	|			И Реализация.Ссылка В (
	|				ВЫБРАТЬ РАЗЛИЧНЫЕ
	|					СтрокиТоваров.Ссылка
	|				ИЗ
	|					Документ.Реализация.Товары КАК СтрокиТоваров
	|				ГДЕ
	|					СтрокиТоваров.Товар В (&ТоварыДляПересчета)
	|				)
	|			)
	|		)
	|       И Реализация.Ссылка <> &ИсключаемаяРеализация
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Ссылка";
	ЗапросРеализацийДляПересчета.УстановитьПараметр("Дата", ДатаНачалаПересчета);
	ЗапросРеализацийДляПересчета.УстановитьПараметр("СсылкаТекущейРеализации", 
		СсылкаТекущейРеализации);
	ЗапросРеализацийДляПересчета.УстановитьПараметр("ТоварыДляПересчета",
		ТоварыДляПересчета);
	ЗапросРеализацийДляПересчета.УстановитьПараметр("ИсключаемаяРеализация",
		ИсключаемаяРеализация);
	РезультатЗапроса = ЗапросРеализацийДляПересчета.Выполнить();
	Возврат РезультатЗапроса.Выгрузить();
КонецФункции

Процедура ОчиститьДвиженияДокумента(СсылкаДокумента) Экспорт
	НаборОстатков = РегистрыНакопления.ОстаткиТоваров.СоздатьНаборЗаписей();
	НаборОстатков.Отбор.Регистратор.Установить(СсылкаДокумента);
	НаборОстатков.Записать();
	НаборОборотов = РегистрыНакопления.Обороты.СоздатьНаборЗаписей();
	НаборОборотов.Отбор.Регистратор.Установить(СсылкаДокумента);
	НаборОборотов.Записать();
КонецПроцедуры

Процедура ПересчитатьРеализацииFIFO(ДатаНачалаПересчета, ТоварыДляПересчета,
		ТекущаяРеализация, ИсключаемаяРеализация, Отказ) Экспорт 
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	Если ТекущаяРеализация = Неопределено Тогда
		СсылкаТекущейРеализации = Документы.Реализация.ПустаяСсылка();
	Иначе
		СсылкаТекущейРеализации = ТекущаяРеализация.Ссылка;
	КонецЕсли;	
	РеализацииДляПересчета = ПолучитьРеализацииДляПересчета(ДатаНачалаПересчета,
		ТоварыДляПересчета, СсылкаТекущейРеализации, ИсключаемаяРеализация);
	Для Каждого СтрокаРеализации ИЗ РеализацииДляПересчета Цикл
		ОчиститьДвиженияДокумента(СтрокаРеализации.Ссылка);
	КонецЦикла;                                             
	Для Каждого СтрокаРеализации ИЗ РеализацииДляПересчета Цикл
		Если СтрокаРеализации.Ссылка = СсылкаТекущейРеализации Тогда
			ТекущаяРеализация.СформироватьДвижениеFIFO(Отказ);
			Если Отказ Тогда
				Возврат;
			КонецЕсли;
		Иначе
			ОбъектРеализации = СтрокаРеализации.Ссылка.ПолучитьОбъект();
			ОбъектРеализации.УстановитьВнутреннийПересчетFIFO();
			ОбъектРеализации.Записать(РежимЗаписиДокумента.Проведение,
				РежимПроведенияДокумента.Неоперативный);
			Если НЕ ОбъектРеализации.Проведен Тогда
				ВызватьИсключение "Не удалось перепровести реализацию: "
					+ Строка(СтрокаРеализации.Ссылка);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры


#КонецОбласти