#Область СинхронизацияПользователейИБ

Процедура СинхронизироватьПользователей() Экспорт
	СписокПользователей = ПользователиИнформационнойБазы.ПолучитьПользователей();
	ЗапросСправочникПользователиИБ = Новый Запрос;
	ЗапросСправочникПользователиИБ.Текст =
	"ВЫБРАТЬ
	|	Пользователи.Ссылка КАК Ссылка,
	|	Пользователи.Наименование КАК Наименование,
	|	Пользователи.ИмяВхода КАК ИмяВхода,
	|	Пользователи.УникальныйИдентификаторПользователя КАК УникальныйИдентификаторПользователя
	|ИЗ
	|	Справочник.ПользователиИБ КАК Пользователи";
	ТаблицаСправочникаПользователейИБ = ЗапросСправочникПользователиИБ.Выполнить().Выгрузить();
	КоличествоПользователейИБ = СписокПользователей.Количество();
	КоличествоОбновленныхЗаписей = 0;
	КоличествоСозданныхЗаписей = 0;
	КоличествоОтсутствующихВИБ = 0;
	КоличествоОшибок = 0;
	КоличествоБезИзменений = 0;
	СписокПользователейБезЗаписиВСправочнике = Новый СписокЗначений;
	Для Каждого Пользователь Из СписокПользователей Цикл
		СписокПользователейБезЗаписиВСправочнике.Добавить(Пользователь);
		ИндексПользователя = СписокПользователейБезЗаписиВСправочнике.Количество() - 1;
		Индекс = ТаблицаСправочникаПользователейИБ.Количество() - 1;
		Пока Индекс >= 0 Цикл
			Если ТаблицаСправочникаПользователейИБ[Индекс].УникальныйИдентификаторПользователя = Пользователь.УникальныйИдентификатор Тогда
				СравнитьИОбновитьДанные(Пользователь, ТаблицаСправочникаПользователейИБ[Индекс], КоличествоОбновленныхЗаписей, КоличествоБезИзменений, КоличествоОшибок);
				СписокПользователейБезЗаписиВСправочнике.Удалить(ИндексПользователя);
				ТаблицаСправочникаПользователейИБ.Удалить(Индекс);
				Прервать;
			КонецЕсли;
			Индекс = Индекс - 1;
		КонецЦикла;
	КонецЦикла;
	Если СписокПользователейБезЗаписиВСправочнике.Количество() > 0 Тогда
		Для Каждого Пользователь Из СписокПользователейБезЗаписиВСправочнике Цикл
			СоздатьЗаписьВСправочникеПользователиИБ(Пользователь.Значение, КоличествоСозданныхЗаписей, КоличествоОшибок);
		КонецЦикла;
	КонецЕсли;
	Если ТаблицаСправочникаПользователейИБ.Количество() > 0 Тогда
		КоличествоОтсутствующихВИБ = ТаблицаСправочникаПользователейИБ.Количество();
		Для Каждого Пользователь Из ТаблицаСправочникаПользователейИБ Цикл
			Попытка
				ОбъектПользователяИБ = Пользователь.Ссылка.ПолучитьОбъект();
				Если ОбъектПользователяИБ.СтатусСинхронизации <> Перечисления.СтатусыСинхронизации.ОтсутствиеВИБ Тогда
					ОбъектПользователяИБ.СтатусСинхронизации = Перечисления.СтатусыСинхронизации.ОтсутствиеВИБ;
					ОбъектПользователяИБ.ДатаПоследнегоОбновления = ТекущаяДата();
					ОбъектПользователяИБ.Записать();
				КонецЕсли;
			Исключение
				КоличествоОшибок = КоличествоОшибок + 1;
				ЗаписьЖурналаРегистрации("СинхронизироватьПользователей", УровеньЖурналаРегистрации.Ошибка,,,
					ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;
	ЗаписатьРезультатСинхронизацииВЖурнал(КоличествоПользователейИБ, КоличествоСозданныхЗаписей, КоличествоОбновленныхЗаписей, КоличествоБезИзменений, КоличествоОтсутствующихВИБ, КоличествоОшибок);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедуры

Процедура СравнитьИОбновитьДанные(Пользователь, ЗаписьСправочникаПользователиИБ, КоличествоОбновленныхЗаписей, КоличествоБезИзменений, КоличествоОшибок)
	Попытка
		Обновлено = Ложь;
		ОбъектПользователяИБ = ЗаписьСправочникаПользователиИБ.Ссылка.ПолучитьОбъект();
		Если Пользователь.ПолноеИмя <> ЗаписьСправочникаПользователиИБ.Наименование Тогда
			ОбъектПользователяИБ.Наименование = Пользователь.ПолноеИмя;
			Обновлено = Истина;
		КонецЕсли;
		Если Пользователь.Имя <> ЗаписьСправочникаПользователиИБ.ИмяВхода Тогда
			ОбъектПользователяИБ.ИмяВхода = Пользователь.Имя;
			Обновлено = Истина;
		КонецЕсли;
		Если ОбъектПользователяИБ.СтатусСинхронизации <> Перечисления.СтатусыСинхронизации.Актуален Тогда
			ОбъектПользователяИБ.СтатусСинхронизации = Перечисления.СтатусыСинхронизации.Актуален;
			Обновлено = Истина;
		КонецЕсли;
		Если Обновлено Тогда
			ОбъектПользователяИБ.ДатаПоследнегоОбновления = ТекущаяДата();
			ОбъектПользователяИБ.Записать();
			КоличествоОбновленныхЗаписей = КоличествоОбновленныхЗаписей + 1;
		Иначе
			КоличествоБезИзменений = КоличествоБезИзменений + 1;
		КонецЕсли;
	Исключение
		КоличествоОшибок = КоличествоОшибок + 1;
		ЗаписьЖурналаРегистрации("СинхронизироватьПользователей", УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

Процедура СоздатьЗаписьВСправочникеПользователиИБ(Пользователь, КоличествоСозданныхЗаписей, КоличествоОшибок)
	Попытка
		НовыйЭлементСправочникаПользователиИБ = Справочники.ПользователиИБ.СоздатьЭлемент();
		НовыйЭлементСправочникаПользователиИБ.Наименование = Пользователь.ПолноеИмя;
		НовыйЭлементСправочникаПользователиИБ.УникальныйИдентификаторПользователя = Пользователь.УникальныйИдентификатор;
		НовыйЭлементСправочникаПользователиИБ.ИмяВхода = Пользователь.Имя;
		НовыйЭлементСправочникаПользователиИБ.СтатусСинхронизации = Перечисления.СтатусыСинхронизации.Актуален;
		НовыйЭлементСправочникаПользователиИБ.ДатаПоследнегоОбновления = ТекущаяДата();
		НовыйЭлементСправочникаПользователиИБ.Записать();
		КоличествоСозданныхЗаписей = КоличествоСозданныхЗаписей + 1;
	Исключение
		КоличествоОшибок = КоличествоОшибок + 1;
		ЗаписьЖурналаРегистрации("СинхронизироватьПользователей", УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

Процедура ЗаписатьРезультатСинхронизацииВЖурнал(КоличествоПользователейИБ, КоличествоСозданныхЗаписей, КоличествоОбновленныхЗаписей, КоличествоБезИзменений, КоличествоОтсутствующихВИБ, КоличествоОшибок)
	ТекстРезультата = СтрШаблон("Пользователей ИБ: %1; Создано: %2; Обновлено: %3; Без изменений: %4; Отсутствуют в ИБ: %5; Ошибок: %6",
		КоличествоПользователейИБ, КоличествоСозданныхЗаписей, КоличествоОбновленныхЗаписей, КоличествоБезИзменений, КоличествоОтсутствующихВИБ, КоличествоОшибок);
	ЗаписьЖурналаРегистрации("СинхронизироватьПользователей", УровеньЖурналаРегистрации.Информация,,,
		ТекстРезультата);
КонецПроцедуры

#КонецОбласти