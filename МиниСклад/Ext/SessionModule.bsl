#Область УстановкаПараметровСеанса

Процедура УстановитьТекущегоПользователя()
	ПараметрыСеанса.ТекущийСотрудник = Справочники.ПользователиИБ.НайтиПоРеквизиту("УникальныйИдентификаторПользователя",
		ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор);
КонецПроцедуры

Процедура УстановкаПараметровСеанса(ТребуемыеПараметры)
	Если ТребуемыеПараметры = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТребуемыеПараметры.Найти("ТекущийСотрудник") <> Неопределено Тогда
		УстановитьТекущегоПользователя();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти