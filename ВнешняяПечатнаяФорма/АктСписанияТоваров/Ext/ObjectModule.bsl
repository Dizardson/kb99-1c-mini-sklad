#Область ПрограммныйИнтерфейс

Функция СведенияОВнешнейОбработке() Экспорт
	ПараметрыРегистрацииВнешнейОбработки = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("3.1.9.144");
	ПараметрыРегистрацииВнешнейОбработки.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиПечатнаяФорма();
	ПараметрыРегистрацииВнешнейОбработки.Версия = "1.1";
	ПараметрыРегистрацииВнешнейОбработки.Назначение.Добавить("Документ.СписаниеНедостачТоваров");
	КомандаПечатиВнешнейОбработки = ПараметрыРегистрацииВнешнейОбработки.Команды.Добавить();
	КомандаПечатиВнешнейОбработки.Представление = "Печать акта списания товаров";
	КомандаПечатиВнешнейОбработки.Идентификатор = "АктСписанияТоваров";
	КомандаПечатиВнешнейОбработки.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода();
	КомандаПечатиВнешнейОбработки.Модификатор = "ПечатьMXL";
	Возврат ПараметрыРегистрацииВнешнейОбработки;
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Процедура Печать(МассивДокументовКПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	ОписаниеПечатнойФормы = УправлениеПечатью.СведенияОПечатнойФорме(КоллекцияПечатныхФорм, "АктСписанияТоваров");
	Если ОписаниеПечатнойФормы <> Неопределено Тогда
		ОписаниеПечатнойФормы.ТабличныйДокумент = ПечатнаяФормаАктаСписания(МассивДокументовКПечати, ОбъектыПечати);
		ОписаниеПечатнойФормы.СинонимМакета = "Акт списания товаров";
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПечатнаяФормаАктаСписания(МассивДокументовКПечати, ОбъектыПечати)
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	ДанныеПечати = ДанныеДляПечати(МассивДокументовКПечати);
	ВыборкаРеквизитовДокументов = ДанныеПечати.Документы.Выбрать();
	ТаблицаТоваров = ДанныеПечати.ТоварыТабличнойЧасти.Выгрузить();
	
	МакетАктаСписания = ПолучитьМакет("МакетАктаСписания");
	ОбластьЗаголовок = МакетАктаСписания.ПолучитьОбласть("Заголовок");
	ОбластьШапка = МакетАктаСписания.ПолучитьОбласть("Шапка");
	ОбластьШапкаТаблицы = МакетАктаСписания.ПолучитьОбласть("ШапкаТаблицы");
	ОбластьСтрокаТовара = МакетАктаСписания.ПолучитьОбласть("СтрокаТовара");
	ОбластьИтоги = МакетАктаСписания.ПолучитьОбласть("Итоги");
	ОбластьПодписи = МакетАктаСписания.ПолучитьОбласть("Подписи");
	
	ПервыйДокумент = Истина;
	Пока ВыборкаРеквизитовДокументов.Следующий() Цикл
		
		Если НЕ ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		НачальнаяСтрокаПечатиДокумента = ТабличныйДокумент.ВысотаТаблицы + 1;
		ШтрихкодированиеПечатныхФорм.ВывестиШтрихкодВТабличныйДокумент(
			ТабличныйДокумент, МакетАктаСписания, ОбластьЗаголовок, ВыборкаРеквизитовДокументов.Ссылка);
		
		ОбластьЗаголовок.Параметры.Заполнить(ВыборкаРеквизитовДокументов);
		ОбластьЗаголовок.Параметры.ДатаАкта = Формат(ВыборкаРеквизитовДокументов.ДатаАкта, "ДФ=dd.MM.yyyy");
		ОбластьШапка.Параметры.Заполнить(ВыборкаРеквизитовДокументов);
		ТабличныйДокумент.Вывести(ОбластьЗаголовок);
		ТабличныйДокумент.Вывести(ОбластьШапка);
		ТабличныйДокумент.Вывести(ОбластьШапкаТаблицы);
		
		СтрокиТоваровДокумента = ТаблицаТоваров.НайтиСтроки(Новый Структура("Ссылка",
			ВыборкаРеквизитовДокументов.Ссылка));
		Для Каждого СтрокаТовара Из СтрокиТоваровДокумента Цикл
			ОбластьСтрокаТовара.Параметры.Заполнить(СтрокаТовара);
			ТабличныйДокумент.Вывести(ОбластьСтрокаТовара);
		КонецЦикла;
		
		ОбластьИтоги.Параметры.КоличествоНаименований = СтрокиТоваровДокумента.Количество();
		ОбластьПодписи.Параметры.Заполнить(ВыборкаРеквизитовДокументов);
		ТабличныйДокумент.Вывести(ОбластьИтоги);
		ТабличныйДокумент.Вывести(ОбластьПодписи);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НачальнаяСтрокаПечатиДокумента,
			ОбъектыПечати, ВыборкаРеквизитовДокументов.Ссылка);
		ПервыйДокумент = Ложь;
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
КонецФункции

Функция ДанныеДляПечати(МассивДокументовКПечати)
	ПакетныйЗапросДанныхДляПечати = Новый Запрос;
	ПакетныйЗапросДанныхДляПечати.УстановитьПараметр("МассивДокументовКПечати", МассивДокументовКПечати);
	ПакетныйЗапросДанныхДляПечати.Текст =
	"ВЫБРАТЬ
	|	РеквизитыДокумента.Ссылка КАК Ссылка,
	|	РеквизитыДокумента.Номер КАК НомерАкта,
	|	РеквизитыДокумента.Дата КАК ДатаАкта,
	|	РеквизитыДокумента.Организация КАК Организация,
	|	РеквизитыДокумента.Подразделение КАК Подразделение,
	|	РеквизитыДокумента.Склад КАК Склад,
	|	РеквизитыДокумента.Комментарий КАК ПричинаСписания,
	|	РеквизитыДокумента.Ответственный КАК Ответственный,
	|	РеквизитыДокумента.Руководитель КАК Руководитель
	|ИЗ
	|	Документ.СписаниеНедостачТоваров КАК РеквизитыДокумента
	|ГДЕ
	|	РеквизитыДокумента.Ссылка В (&МассивДокументовКПечати)
	|УПОРЯДОЧИТЬ ПО
	|	ДатаАкта,
	|	НомерАкта
	|;
	|ВЫБРАТЬ
	|	ТоварыТабличнойЧастиДокумента.Ссылка КАК Ссылка,
	|	ТоварыТабличнойЧастиДокумента.НомерСтроки КАК НомерСтроки,
	|	ТоварыТабличнойЧастиДокумента.Номенклатура КАК Номенклатура,
	|	ТоварыТабличнойЧастиДокумента.Номенклатура.Артикул КАК Артикул,
	|	ТоварыТабличнойЧастиДокумента.Количество КАК КоличествоТовара,
	|	ТоварыТабличнойЧастиДокумента.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ИЗ
	|	Документ.СписаниеНедостачТоваров.Товары КАК ТоварыТабличнойЧастиДокумента
	|ГДЕ
	|	ТоварыТабличнойЧастиДокумента.Ссылка В (&МассивДокументовКПечати)
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерСтроки";
	МассивРезультатовПакетногоЗапроса = ПакетныйЗапросДанныхДляПечати.ВыполнитьПакет();
	ДанныеПечати = Новый Структура;
	ДанныеПечати.Вставить("Документы", МассивРезультатовПакетногоЗапроса[0]);
	ДанныеПечати.Вставить("ТоварыТабличнойЧасти", МассивРезультатовПакетногоЗапроса[1]);
	Возврат ДанныеПечати;
КонецФункции

#КонецОбласти